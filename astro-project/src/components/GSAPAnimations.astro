<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  // Check if mobile for reduced animations
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  // Set default ease and optimize for performance
  gsap.defaults({ 
    ease: 'power2.out',
    force3D: true,
  });
  
  // Configure ScrollTrigger for better performance
  ScrollTrigger.config({
    limitCallbacks: true,
    ignoreMobileResize: true,
  });
  
  document.addEventListener('DOMContentLoaded', () => {
    // Skip animations if user prefers reduced motion
    if (prefersReducedMotion) {
      gsap.set('.service-card, .advantage-card, .section-header, .whyus-header, .cta-card, .cases-header, .case-card, .about-left, .about-right, .stat-card, .testimonial-card', {
        opacity: 1,
        clearProps: 'all'
      });
      return;
    }
    
    // Reduced animation values for mobile
    const animDistance = isMobile ? 30 : 60;
    const animDuration = isMobile ? 0.5 : 0.8;
    const staggerDelay = isMobile ? 0.08 : 0.15;
    
    // Ensure elements are visible first, then animate
    gsap.set('.service-card, .advantage-card, .section-header, .whyus-header, .cta-card, .cases-header, .case-card, .about-left, .about-right, .stat-card, .testimonial-card', {
      opacity: 1,
      clearProps: 'transform'
    });
    
    // Service cards with stagger
    const serviceCards = gsap.utils.toArray('.service-card');
    if (serviceCards.length) {
      gsap.fromTo(serviceCards, 
        { y: animDistance, opacity: 0 },
        {
          scrollTrigger: {
            trigger: '.services-grid',
            start: 'top 85%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration,
          stagger: staggerDelay
        }
      );
    }
    
    // Section headers
    gsap.utils.toArray('.section-header, .whyus-header, .testimonials-header').forEach((header: any) => {
      gsap.fromTo(header,
        { y: animDistance * 0.6, opacity: 0 },
        {
          scrollTrigger: {
            trigger: header,
            start: 'top 88%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration
        }
      );
    });
    
    // Advantage cards
    const advantageCards = gsap.utils.toArray('.advantage-card');
    if (advantageCards.length) {
      gsap.fromTo(advantageCards,
        { y: animDistance * 0.8, opacity: 0 },
        {
          scrollTrigger: {
            trigger: '.whyus-grid',
            start: 'top 85%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration * 0.9,
          stagger: staggerDelay * 0.7
        }
      );
    }
    
    // Testimonial cards
    const testimonialCards = gsap.utils.toArray('.testimonial-card');
    if (testimonialCards.length) {
      gsap.fromTo(testimonialCards,
        { y: animDistance * 0.7, opacity: 0 },
        {
          scrollTrigger: {
            trigger: '.testimonials-grid',
            start: 'top 85%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration,
          stagger: staggerDelay
        }
      );
    }
    
    // CTA section
    const ctaCard = document.querySelector('.cta-card');
    if (ctaCard) {
      gsap.fromTo(ctaCard,
        { y: animDistance * 0.8, opacity: 0 },
        {
          scrollTrigger: {
            trigger: ctaCard,
            start: 'top 85%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration
        }
      );
    }
    
    // About section - left side
    const aboutLeft = document.querySelector('.about-left');
    if (aboutLeft) {
      gsap.fromTo(aboutLeft,
        { x: isMobile ? 0 : -animDistance, y: isMobile ? animDistance * 0.5 : 0, opacity: 0 },
        {
          scrollTrigger: {
            trigger: '#about',
            start: 'top 75%',
            once: true
          },
          x: 0,
          y: 0,
          opacity: 1,
          duration: animDuration * 1.1
        }
      );
    }
    
    // About section - right side (stat cards)
    const statCards = gsap.utils.toArray('.stat-card');
    if (statCards.length) {
      gsap.fromTo(statCards,
        { y: animDistance * 0.6, opacity: 0, scale: isMobile ? 1 : 0.95 },
        {
          scrollTrigger: {
            trigger: '#about',
            start: 'top 70%',
            once: true
          },
          y: 0,
          scale: 1,
          opacity: 1,
          duration: animDuration * 0.9,
          stagger: staggerDelay,
          ease: isMobile ? 'power2.out' : 'back.out(1.4)'
        }
      );
    }
    
    // Cases header
    const casesHeader = document.querySelector('.cases-header');
    if (casesHeader) {
      gsap.fromTo(casesHeader,
        { y: animDistance * 0.6, opacity: 0 },
        {
          scrollTrigger: {
            trigger: casesHeader,
            start: 'top 88%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration
        }
      );
    }
    
    // Case cards
    const caseCards = gsap.utils.toArray('.case-card');
    if (caseCards.length) {
      gsap.fromTo(caseCards,
        { y: animDistance * 0.8, opacity: 0 },
        {
          scrollTrigger: {
            trigger: '.cases-grid',
            start: 'top 85%',
            once: true
          },
          y: 0,
          opacity: 1,
          duration: animDuration * 0.9,
          stagger: staggerDelay * 0.8
        }
      );
    }
    
    // Magnetic hover effect - only on desktop
    if (!isMobile) {
      document.querySelectorAll('[data-magnetic]').forEach(el => {
        el.addEventListener('mouseenter', () => {
          gsap.to(el, { scale: 1.02, duration: 0.3 });
        });
        el.addEventListener('mouseleave', () => {
          gsap.to(el, { scale: 1, duration: 0.3 });
        });
      });
    }
  });
</script>
