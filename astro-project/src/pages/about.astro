---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
---

<Layout 
  title="О нас — Onleadify | Команда веб-разработки и автоматизации"
  description="Команда экспертов в digital-решениях с опытом более 2 лет. Создаём цифровые продукты, которые помогают бизнесу расти."
>
  <main class="min-h-screen bg-background">
    <Header client:load />
    
    <section class="pt-32 pb-16 sm:pb-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="inline-block text-xs font-medium text-muted-foreground uppercase tracking-widest mb-4">О нас</span>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-6">
              Команда экспертов в digital-решениях
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed mb-6">
              Мы — команда разработчиков, дизайнеров и маркетологов с опытом более 2 лет. 
              Создаём цифровые продукты, которые помогают бизнесу расти и зарабатывать больше.
            </p>
            <p class="text-lg text-muted-foreground leading-relaxed mb-8">
              Каждый проект для нас — это партнёрство. Мы погружаемся в специфику вашего бизнеса, 
              чтобы предложить решение, которое действительно работает.
            </p>
            
            <div class="grid grid-cols-3 gap-6">
              <div class="text-center">
                <div class="text-4xl font-bold text-foreground mb-2">12+</div>
                <div class="text-sm text-muted-foreground">проектов</div>
              </div>
              <div class="text-center">
                <div class="text-4xl font-bold text-foreground mb-2">100%</div>
                <div class="text-sm text-muted-foreground">довольных клиентов</div>
              </div>
              <div class="text-center">
                <div class="text-4xl font-bold text-foreground mb-2">2+</div>
                <div class="text-sm text-muted-foreground">лет на рынке</div>
              </div>
            </div>
          </div>
          
          <div class="space-y-6">
            <div class="rounded-2xl bg-card/50 backdrop-blur-sm border border-border/50 p-8">
              <h3 class="text-xl font-bold text-foreground mb-4">Наш подход</h3>
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-muted-foreground">Глубокое погружение в бизнес клиента</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-muted-foreground">Прозрачная коммуникация на каждом этапе</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-muted-foreground">Фокус на результат и ROI</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-muted-foreground">Поддержка после запуска проекта</span>
                </li>
              </ul>
            </div>
            
            <div class="rounded-2xl bg-card/50 backdrop-blur-sm border border-border/50 p-8">
              <h3 class="text-xl font-bold text-foreground mb-4">Технологии</h3>
              <div class="flex flex-wrap gap-2">
                {["React", "Next.js", "Astro", "Node.js", "Python", "PostgreSQL", "TailwindCSS", "AI/ML"].map((tech) => (
                  <span class="px-3 py-1.5 text-sm rounded-full bg-secondary text-muted-foreground">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <CTA />
    <Footer />
  </main>
</Layout>
