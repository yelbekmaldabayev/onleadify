---
import '../styles/globals.css'
import ParticlesBackground from '../components/ParticlesBackground.astro'
import MagneticButton from '../components/MagneticButton.astro'
import ScrollReveal from '../components/ScrollReveal.astro'
import SmoothScroll from '../components/SmoothScroll.astro'
import GSAPAnimations from '../components/GSAPAnimations.astro'
import GradientMesh from '../components/GradientMesh.astro'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
}

const { 
  title = 'Onleadify — Веб-студия и AI-автоматизация | Создание сайтов и автоматизация бизнеса', 
  description = 'Профессиональная веб-разработка и AI-автоматизация для бизнеса. Создаём системы лидогенерации, которые реально приводят клиентов. Разработка сайтов под ключ, автоматизация процессов.',
  image = '/og-image.svg',
  type = 'website'
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, 'https://onleadify.com')
---

<!doctype html>
<html lang="ru" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg" />
		<link rel="icon" type="image/svg+xml" sizes="192x192" href="/favicon-192.svg" />
		<link rel="icon" type="image/svg+xml" sizes="512x512" href="/favicon-512.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="веб-разработка, AI автоматизация, создание сайтов, лидогенерация, веб-студия, автоматизация бизнеса, разработка под ключ, onleadify, онлидифай, разработка сайтов, создание лендингов, crm интеграция, чат-боты" />
		<meta name="author" content="Onleadify" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:site_name" content="Onleadify" />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Onleadify — Веб-студия и AI-автоматизация" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />
		<meta name="twitter:image:alt" content="Onleadify — Веб-студия и AI-автоматизация" />
		<meta name="twitter:creator" content="@onleadify" />
		<meta name="twitter:site" content="@onleadify" />
		
		<!-- Additional SEO -->
		<meta name="theme-color" content="#000000" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Onleadify" />
		<meta name="application-name" content="Onleadify" />
		<meta name="msapplication-TileColor" content="#7877c6" />
		<meta name="msapplication-config" content="/browserconfig.xml" />
		
		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ProfessionalService",
				"@id": "https://onleadify.com/#organization",
				"name": "Onleadify",
				"alternateName": "Онлидифай",
				"url": "https://onleadify.com",
				"logo": {
					"@type": "ImageObject",
					"url": "https://onleadify.com/logo.svg",
					"width": "512",
					"height": "512"
				},
				"image": "https://onleadify.com/og-image.svg",
				"description": "Профессиональная веб-разработка и AI-автоматизация для бизнеса. Создаём системы лидогенерации, которые реально приводят клиентов.",
				"slogan": "Создаём системы, которые приводят клиентов",
				"priceRange": "$$",
				"telephone": "+7",
				"email": "info@onleadify.com",
				"address": {
					"@type": "PostalAddress",
					"addressCountry": "KZ",
					"addressLocality": "Казахстан"
				},
				"areaServed": [
					{
						"@type": "Country",
						"name": "Казахстан"
					},
					{
						"@type": "Country",
						"name": "Россия"
					}
				],
				"serviceType": [
					"Веб-разработка",
					"AI-автоматизация",
					"Создание сайтов",
					"Лидогенерация",
					"CRM интеграция",
					"Разработка чат-ботов"
				],
				"knowsAbout": [
					"Web Development",
					"AI Automation",
					"Lead Generation",
					"CRM Integration",
					"Chatbot Development"
				],
				"sameAs": []
			}
		</script>
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Onleadify",
				"url": "https://onleadify.com",
				"description": "Создаём системы, которые приводят клиентов. Веб-разработка и AI-автоматизация для бизнеса.",
				"potentialAction": {
					"@type": "SearchAction",
					"target": "https://onleadify.com/?s={search_term_string}",
					"query-input": "required name=search_term_string"
				}
			}
		</script>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<GradientMesh />
		<ParticlesBackground />
		<slot />
		<MagneticButton />
		<ScrollReveal />
		<SmoothScroll />
		<GSAPAnimations />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		letter-spacing: -0.01em;
	}
	
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
		letter-spacing: -0.02em;
	}
	
	::selection {
		background: rgba(120, 119, 198, 0.3);
		color: #fff;
	}
</style>
